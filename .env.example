# ---- Telegram (get API_ID / API_HASH at https://my.telegram.org -> API development tools) ----
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=111111111,222222222

# ---- MongoDB (Atlas free tier works; allow 0.0.0.0/0 in Network Access for Render/Koyeb) ----
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=premium_bot

# ---- Log channels (make the bot ADMIN in both; ids look like -1001234567890) ----
LOG_CHANNEL=
BUY_LOG_CHANNEL=
BUY_LOG_SHOW_USER=0

# ---- Branding / links (optional) ----
BRAND_NAME=Premium Verse
WELCOME_PHOTO=
SUPPORT_URL=https://t.me/your_support_username
PROOFS_URL=https://t.me/your_proofs_channel
MINIAPP_URL=

# ---- Payments ----
UPI_ID=yourname@upi
UPI_NAME=Your Name
USDT_ADDRESS=
USDT_NETWORK=TRC20
INR_PER_USD=90
ENABLE_STARS=0
STARS_PER_USD=60

# ---- Wallet / referral ----
POINTS_PER_INR=1
POINTS_PER_WALLET_INR=10
REFERRAL_BONUS_POINTS=50

# ---- Runtime ----
# PORT is set automatically by Render/Koyeb/Railway. Locally it defaults to 8080.
LOG_LEVEL=INFO
WORKERS=8
API_KEY=change-me-long-random
WEBHOOK_SECRET=change-me-long-random
# KEEPALIVE_URL=https://your-app.onrender.com   (auto-detected on Render/Koyeb)
